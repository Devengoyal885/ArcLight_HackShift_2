rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The app uses scoped UIDs: "{auth.uid}_{role}" (e.g. "abc123_candidate").
    // So we check that the document UID *starts with* the authenticated UID.
    function isOwner(scopedUid) {
      return request.auth != null &&
        (request.auth.uid == scopedUid ||
         scopedUid.matches(request.auth.uid + '_.+'));
    }

    // Safe role lookup — checks if the specific role profile exists
    function hasRole(role) {
      let roleRef = /databases/$(database)/documents/users/$(request.auth.uid + '_' + role)/profile/data;
      return exists(roleRef) && get(roleRef).data.get('role', '') == role;
    }

    function isCandidate()       { return hasRole('candidate'); }
    function isFaculty()         { return hasRole('academician'); }
    function isEmployer()        { return hasRole('employer'); }
    function isInstitutionAdmin(){ return hasRole('institution'); }

    function sameInstitution(institutionCode) {
      let candidateRef = /databases/$(database)/documents/users/$(request.auth.uid + '_candidate')/profile/data;
      let facultyRef   = /databases/$(database)/documents/users/$(request.auth.uid + '_academician')/profile/data;
      let instRef      = /databases/$(database)/documents/users/$(request.auth.uid + '_institution')/profile/data;
      return (exists(candidateRef) && get(candidateRef).data.get('institutionCode','') == institutionCode) ||
             (exists(facultyRef)   && get(facultyRef).data.get('institutionCode','')   == institutionCode) ||
             (exists(instRef)      && get(instRef).data.get('institutionCode','')      == institutionCode);
    }


    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{scopedUid} {
      // Top-level user document
      allow read:  if isSignedIn() && (isOwner(scopedUid) || isEmployer() || isFaculty() || isInstitutionAdmin());
      allow write: if isSignedIn() && isOwner(scopedUid);

      // Profile — stored at profile/data (not profile/main)
      match /profile/{docId} {
        allow read:  if isSignedIn() && (isOwner(scopedUid) || isFaculty() || isInstitutionAdmin() || isEmployer());
        // Write allowed during onboarding even before role is known
        allow write: if isSignedIn() && isOwner(scopedUid);
      }

      // Capabilities
      match /capabilities/{capId} {
        allow read:  if isSignedIn();
        allow write: if isSignedIn() && isOwner(scopedUid);
      }

      // Projects
      match /projects/{projId} {
        allow read:  if isSignedIn() && (isOwner(scopedUid) || isFaculty() || isInstitutionAdmin() || isEmployer());
        allow write: if isSignedIn() && isOwner(scopedUid);
      }

      // Certifications
      match /certifications/{certId} {
        allow read:  if isSignedIn() && (isOwner(scopedUid) || isFaculty() || isInstitutionAdmin() || isEmployer());
        allow write: if isSignedIn() && isOwner(scopedUid);
      }

      // Aptitude results
      match /aptitudeResults/{resultId} {
        allow read:  if isSignedIn() && (isOwner(scopedUid) || isFaculty() || isInstitutionAdmin());
        allow write: if isSignedIn() && isOwner(scopedUid);
      }

      // Misc owner-only subcollections
      match /careerTarget/{docId}       { allow read, write: if isSignedIn() && isOwner(scopedUid); }
      match /learningPath/{docId}       { allow read, write: if isSignedIn() && isOwner(scopedUid); }
      match /savedOpportunities/{oppId} { allow read, write: if isSignedIn() && isOwner(scopedUid); }

      // Interview sessions — immutable after creation
      match /interviewSessions/{sessionId} {
        allow read:   if isSignedIn() && (isOwner(scopedUid) || isInstitutionAdmin() || isFaculty());
        allow create: if isSignedIn() && isOwner(scopedUid);
        allow update, delete: if false;
      }

      // Applications (candidate-side copy)
      match /applications/{appId} {
        allow read:  if isSignedIn() && (isOwner(scopedUid) || isEmployer() || isInstitutionAdmin());
        allow write: if isSignedIn() && (isOwner(scopedUid) || isEmployer());
      }

      // Per-user notification inbox
      match /notifications/items/{notifId} {
        allow read:   if isSignedIn() && isOwner(scopedUid);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(scopedUid);
        allow delete: if isSignedIn() && isOwner(scopedUid);
      }

      // Catch-all for any other subcollections
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && isOwner(scopedUid);
      }
    }


    // ── Collection Groups ──────────────────────────────────────────────────────
    match /{path=**}/profile/{docId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/linkedCompanies/{docId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/applications/{docId} {
      allow read: if isSignedIn();
    }

    // ── Global Notifications (legacy + new path) ───────────────────────────────
    match /notifications/{uid} {
      allow read, write: if isSignedIn() && isOwner(uid);

      match /items/{notifId} {
        allow read:   if isSignedIn() && isOwner(uid);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(uid);
        allow delete: if isSignedIn() && isOwner(uid);
      }
    }


    // ── Posted Roles ──────────────────────────────────────────────────────────
    match /postedRoles/{roleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isEmployer();
      allow update, delete: if isSignedIn() && isEmployer()
        && resource.data.employerUid == request.auth.uid;

      match /applications/{appId} {
        allow create: if isSignedIn() && isCandidate();
        allow read:   if isSignedIn() && (isEmployer() || isInstitutionAdmin() || isFaculty());
        allow update: if isSignedIn() && (isEmployer() || isOwner(resource.data.get('candidateUid', '')));
        allow delete: if false;
      }
    }


    // ── Employers (interview slots, company profile) ───────────────────────────
    match /employers/{employerScopedUid} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isOwner(employerScopedUid);

      match /interviewSlots/{slotId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn() && isOwner(employerScopedUid);
        allow update: if isSignedIn() && (isOwner(employerScopedUid) || isCandidate());
        allow delete: if isSignedIn() && isOwner(employerScopedUid);
      }
      
      // Catch-all for employer subcollections (postedRoles, shortlist, notes, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && isOwner(employerScopedUid);
      }
    }


    // ── Institutions ──────────────────────────────────────────────────────────
    match /institutions/{institutionCode} {
      allow read:  if isSignedIn() && sameInstitution(institutionCode);
      allow write: if isSignedIn() && isInstitutionAdmin() && sameInstitution(institutionCode);

      match /events/{eventId} {
        allow read:  if isSignedIn() && sameInstitution(institutionCode);
        allow write: if isSignedIn() && isInstitutionAdmin() && sameInstitution(institutionCode);
      }

      match /linkedCompanies/{companyId} {
        allow read:  if isSignedIn() && sameInstitution(institutionCode);
        allow write: if isSignedIn() && isInstitutionAdmin() && sameInstitution(institutionCode);
      }
    }


    // ── Placement Drives ──────────────────────────────────────────────────────
    match /placementDrives/{driveId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isInstitutionAdmin();
      allow delete: if isSignedIn() && isInstitutionAdmin();

      match /registrations/{uid} {
        allow read:   if isSignedIn() && (isOwner(uid) || isInstitutionAdmin() || isEmployer());
        allow create: if isSignedIn() && isOwner(uid);
        allow update: if isSignedIn() && (isOwner(uid) || isInstitutionAdmin());
        allow delete: if false;
      }
    }


    // ── Assessment Sessions ────────────────────────────────────────────────────
    match /assessmentSessions/{sessionId} {
      allow read:   if isSignedIn() && (resource.data.uid == request.auth.uid ||
                       isOwner(resource.data.get('uid','')) ||
                       isInstitutionAdmin() || isFaculty());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.get('uid',''));
      allow delete: if false;
    }


    // ── Public Profiles / Username slugs ──────────────────────────────────────
    match /usernames/{slug} {
      allow read:  if true;
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /publicProfiles/{uid} {
      allow read:  if true;
      allow write: if isSignedIn() && isOwner(uid);
    }


    // ── Mentorship Requests ────────────────────────────────────────────────────
    match /mentorshipRequests/{mentorUid} {
      allow read: if isSignedIn() && isOwner(mentorUid);

      match /requests/{fromUid} {
        allow read:   if isSignedIn() && (isOwner(mentorUid) || isOwner(fromUid));
        allow create: if isSignedIn() && isOwner(fromUid);
        allow update: if isSignedIn() && isOwner(mentorUid);
        allow delete: if false;
      }
    }


    // ── Email Queue (Firebase Trigger Email extension) ────────────────────────
    match /mail/{docId} {
      // Only allow sending emails to oneself or restrict to specific triggers
      allow create: if isSignedIn() && (request.resource.data.to == request.auth.token.email || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }


    // ── Invites ───────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && (isInstitutionAdmin() || isFaculty());
      // Only allow updating to mark as used/claimed, or if admin
      allow update: if isSignedIn() && (isInstitutionAdmin() || isFaculty() || request.resource.data.claimedBy == request.auth.uid);
      allow delete: if isSignedIn() && isInstitutionAdmin();
    }


    // ── Certificates ──────────────────────────────────────────────────────────
    match /certificates/{certId} {
      allow read:   if true;
      allow create: if isSignedIn() && (isInstitutionAdmin() || isFaculty());
      allow update: if isSignedIn() && (isInstitutionAdmin() || isFaculty());
      allow delete: if isSignedIn() && isInstitutionAdmin();
    }


    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
