# CapAble Environment Variables — copy to .env and fill in your values

# ---- AI Keys (SERVER-SIDE ONLY — never use VITE_ prefix for these) ----
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# ---- Backend server URL (frontend reads this) ----
VITE_SERVER_URL=http://localhost:5000

# ---- Firebase (frontend — these are public by design) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary (image upload — frontend) ----
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Serper (web search — SERVER-SIDE ONLY) ----
SERPER_API_KEY=your_serper_key_here

# ---- Adzuna Job Board API (frontend — free tier available) ----
# Get your keys at: https://developer.adzuna.com/
VITE_ADZUNA_APP_ID=your_adzuna_app_id
VITE_ADZUNA_APP_KEY=your_adzuna_app_key

# ---- VAPID Push Notifications ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# ---- Twilio WhatsApp/SMS (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ---- SMTP Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CapAble" <noreply@capable.ai>
