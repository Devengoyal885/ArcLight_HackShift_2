{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://wardrobe-app-adf6e.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/((?!assets|favicon|manifest|service-worker|icons|public|__|\\.well-known).*)",
      "destination": "/index.html"
    }
  ]
}
